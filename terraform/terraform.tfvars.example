# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is git-ignored; do not commit it.

aws_region = "ap-south-1"

# Name of an EC2 key pair that already exists in ap-south-1
jenkins_key_name = "REPLACE_WITH_YOUR_KEY_PAIR_NAME"

# Optional overrides (defaults shown). If you change these names,
# update the Jenkinsfile environment block to match.
# ecr_repository_name = "taskflow-frontend"
# cluster_name        = "taskflow-eks"
# kubernetes_version  = "1.37"
